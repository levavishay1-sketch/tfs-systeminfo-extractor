<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TfsSystemInfoExtractor</AssemblyName>
    <RootNamespace>TfsSystemInfoExtractor.App</RootNamespace>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TfsSystemInfoExtractor.Core\TfsSystemInfoExtractor.Core.csproj" />
    <ProjectReference Include="..\TfsSystemInfoExtractor.Infrastructure\TfsSystemInfoExtractor.Infrastructure.csproj" />
    <ProjectReference Include="..\TfsSystemInfoExtractor.Web\TfsSystemInfoExtractor.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <!-- Package the whole app as one self-contained EXE (see FodyWeavers.xml). -->
  <ItemGroup>
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The default configuration is embedded in the EXE so a bare "copy the EXE and run"
    deployment works. An appsettings.json / appsettings.local.json placed next to the
    EXE, or TFS_-prefixed environment variables, still override it at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="TfsSystemInfoExtractor.App.appsettings.json" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
